# ==== مصدر البيانات (شؤون الطلاب) ====
# نوع الملف المصدر: sqlite | access
SOURCE_DB_TYPE=sqlite

# المسار الكامل للملف الحي (لا تُقرأ منه مباشرة أبدًا — يُنسخ أولاً)
SOURCE_DB_PATH=C:\ProgramData\SchoolERP\data\students.db

# اسم الجدول الرئيسي للطلاب في المصدر (يُحدَّد بعد تشغيل discover-schema)
SOURCE_STUDENTS_TABLE=الطلاب

# ==== API الحالية بالبرنامج (اختياري - للمزامنة اللحظية) ====
SOURCE_API_BASE_URL=http://localhost:8080/api
SOURCE_API_STUDENTS_ENDPOINT=/students
SOURCE_API_KEY=

# ==== قاعدة بيانات نظام الكنترول الجديد ====
CONTROL_DB_HOST=localhost
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=control_system
CONTROL_DB_USER=control_app
CONTROL_DB_PASSWORD=

# ==== إعدادات التشغيل ====
# مجلد النسخ المؤقتة أثناء القراءة الآمنة من المصدر
SNAPSHOT_DIR=./tmp
