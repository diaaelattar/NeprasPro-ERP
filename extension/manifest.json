{
  "manifest_version": 3,
  "name": "جامع بيانات الطلاب الذكي",
  "version": "14.0",
  "description": "v14: إرسال مباشر لـ NeprasPro - مزامنة فورية مع قاعدة بيانات نبراس برو - المطور: م. ضياء العطار",
  "author": "ضياء العطار - 01118209309",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "جامع بيانات الطلاب الذكي v14.0"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.emis.gov.eg/*",
    "*://emis.gov.eg/*",
    "*://*.moe.gov.eg/*",
    "*://moe.gov.eg/*",
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.emis.gov.eg/*",
        "*://emis.gov.eg/*",
        "*://*.moe.gov.eg/*",
        "*://moe.gov.eg/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
