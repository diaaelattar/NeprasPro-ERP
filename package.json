{
  "name": "nepras-pro",
  "version": "1.3.0",
  "description": "NeprasPro School ERP Desktop App — Enterprise Edition",
  "author": "NeprasPro Educational ERP (Copyright © 2026)",
  "main": "electron/main.js",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "electron:dev": "electron .",
    "react:dev": "npm run dev --prefix frontend",
    "backend:dev": "node --watch --watch-path=backend backend/server.js",
    "dev": "concurrently \"npm run react:dev\" \"npm run backend:dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:electron": "cross-env ELECTRON_BUILD=true npm run build --prefix frontend",
    "dist": "npm run build:electron && electron-builder",
    "generate-key": "node scripts/generate_key.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "pdf-parse": "^2.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nepraspro.erp",
    "productName": "NeprasPro ERP",
    "extraMetadata": {
      "productNameAr": "منظومة نبراس برو التعليمية"
    },
    "copyright": "Copyright © 2026 NeprasPro ERP System. All Rights Reserved. (جميع الحقوق محفوظة لمنظومة نبراس التعليمية)",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "backend/**/*",
      "backend/node_modules/**/*",
      "database/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نبراس برو - نظام إدارة المدارس",
      "runAfterFinish": true,
      "unicode": true,
      "license": "build/license_ar.txt",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "puppeteer": "^21.11.0",
    "sql.js": "^1.14.1",
    "winston": "^3.19.0"
  }
}
